{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "penguin-cup-fpl-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-19",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "LEAGUE_ID": "511690",
    "ALLOWED_ORIGINS": "*"
  },
  "kv_namespaces": [
    {
      "binding": "FPL_CACHE",
      "id": "cb91e950c5d84f7b9f87c638d1ccdc25",
      "remote": true
    }
  ],
  "d1_databases": [{
    "binding": "OPS_DB",
    "database_name": "penguin-fantasy-operations",
    "database_id": "b403256c-28dc-4524-86f0-c1f83c83b458",
    "migrations_dir": "migrations"
  }],
  "triggers": {
    "crons": ["*/5 * * * *", "30 23 * * *"]
  }
}
