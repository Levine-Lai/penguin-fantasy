{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "penguin-cup-fpl-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-19",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "LEAGUE_ID": "511690",
    "ALLOWED_ORIGINS": "*"
  },
  "kv_namespaces": [
    {
      "binding": "FPL_CACHE",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *", "30 23 * * *"]
  }
}
